{
  "expo": {
    "name": "BMarket",
    "slug": "bmarket",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/logo.png",
    "scheme": "bmarket",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/branding/logo.png",
      "bundleIdentifier": "id.ac.binus.bmarket",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0057B8",
        "foregroundImage": "./assets/branding/logo.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "id.ac.binus.bmarket",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/branding/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "BMarket memerlukan akses foto untuk mengunggah gambar listing." }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0057B8",
          "image": "./assets/branding/logo.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
