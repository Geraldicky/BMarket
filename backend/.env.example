PORT=3000
NODE_ENV=development

# Prisma schema menggunakan PostgreSQL, bukan MySQL/XAMPP.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bmarket?schema=public"

# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="ganti_dengan_secret_acak_minimal_32_karakter"
JWT_EXPIRES_IN="7d"

SSO_ALLOWED_DOMAINS="@binus.ac.id,@student.binus.ac.id,@binus.edu"

# Verifikasi email OTP. Buat OTP_HASH_SECRET acak seperti JWT_SECRET.
OTP_HASH_SECRET="ganti_dengan_secret_otp_acak_minimal_32_karakter"
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_MIN_RESPONSE_MS=350

# Gmail cocok untuk development/demo. Gunakan App Password, bukan password akun.
# Tanpa SMTP pada NODE_ENV=development, OTP dicetak di terminal backend.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BMarket <your-email@gmail.com>"
OTP_DEV_LOG=true

CORS_ORIGIN="http://localhost:8081,http://localhost:19006"
UPLOAD_DIR="uploads"
# Opsional untuk production/CDN. Saat development URL upload mengikuti host request (LAN-friendly).
PUBLIC_BASE_URL=""

# V21: checkout PENDING menahan stok sementara sebelum pembayaran.
CHECKOUT_RESERVATION_MINUTES=15
