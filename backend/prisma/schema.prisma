// prisma/schema.prisma
// =============================================
// BINUS Marketplace - Database Schema
// =============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  studentId    String?  @unique
  phone        String?
  bio          String?  @db.Text
  avatarUrl    String?
  role         Role     @default(STUDENT)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)
  // Virtual balance: saldo simulasi untuk sistem escrow
  // Buyer topup saldo → beli → saldo masuk escrow → COMPLETED → seller terima
  balance      Decimal  @default(0.00) @db.Decimal(12, 2)
  escrow       Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings           Listing[]
  buyerTransactions  Transaction[]      @relation("BuyerTransactions")
  sellerTransactions Transaction[]      @relation("SellerTransactions")
  reviewsGiven       Review[]           @relation("ReviewsGiven")
  reviewsReceived    Review[]           @relation("ReviewsReceived")
  complaints         Complaint[]
  messagesSent       Message[]          @relation("MessagesSent")
  chatRoomsA         ChatRoom[]         @relation("UserA")
  chatRoomsB         ChatRoom[]         @relation("UserB")
  emailVerification  EmailVerification?
  passwordReset      PasswordReset?
  wishlistItems      Wishlist[]
  recentlyViewed     RecentlyViewed[]
  disputesOpened     Dispute[]         @relation("DisputesOpened")
  disputesResolved   Dispute[]         @relation("DisputesResolved")
  blocksInitiated    UserBlock[]       @relation("Blocker")
  blocksReceived     UserBlock[]       @relation("Blocked")
  notifications      Notification[]
  walletLedger       WalletLedger[]

  @@map("users")
}

// Kode OTP tidak pernah disimpan mentah. codeHash berisi HMAC dari kode
// dan otomatis dihapus setelah verifikasi berhasil.
model EmailVerification {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
  @@map("email_verifications")
}

// Reset password memakai dua rahasia terpisah: OTP singkat untuk verifikasi
// dan resetToken acak untuk mengizinkan satu kali perubahan password.
model PasswordReset {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash            String
  expiresAt           DateTime
  attempts            Int       @default(0)
  lastSentAt          DateTime  @default(now())
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([expiresAt])
  @@index([resetTokenExpiresAt])
  @@map("password_resets")
}

enum Role {
  STUDENT
  ADMIN
}

// ─────────────────────────────────────────────
// LISTING (Product / Service)
// ─────────────────────────────────────────────
model Listing {
  id          String        @id @default(uuid())
  title       String
  description String        @db.Text
  price       Decimal       @db.Decimal(12, 2)
  category    Category
  type        ListingType   @default(PRODUCT)
  // Pola penjualan. Dipisahkan dari type agar barang one-off, stok, dan PO
  // dapat memiliki lifecycle berbeda tanpa memecah kompatibilitas PRODUCT/SERVICE.
  mode        ListingMode   @default(ONE_OFF)
  images      String        @default("[]") @db.Text
  status      ListingStatus @default(ACTIVE)
  condition   Condition?
  // Stock management — hanya berlaku untuk tipe PRODUCT
  // Jika null = tidak dibatasi (untuk SERVICE)
  stock       Int? // Stok awal yang diset seller
  stockLeft   Int? // Stok/kuota tersisa (direservasi saat checkout)
  // Field khusus PREORDER. stock/stockLeft tetap dipakai sebagai kapasitas agar
  // reservasi checkout tetap atomic dan tidak oversell.
  preorderStatus         PreorderStatus?
  preorderDeadline       DateTime?
  preorderReadyAt        DateTime?
  preorderQuota          Int?
  preorderMinOrder       Int?
  preorderMaxPerBuyer    Int?
  preorderPickupLocation String?
  preorderPickupNote     String? @db.Text
  // Seller menentukan metode penyerahan yang tersedia untuk listing ini.
  // Buyer memilih salah satunya saat checkout.
  fulfillmentMethods FulfillmentMethod[] @default([CAMPUS_MEETUP, INSTANT_COURIER])
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  // Seller dapat menghapus listing INACTIVE dari etalase tanpa merusak histori transaksi.
  sellerArchivedAt DateTime?

  transactions   Transaction[]
  wishlistedBy    Wishlist[]
  recentlyViewed  RecentlyViewed[]

  @@index([status, createdAt])
  @@index([category, status])
  @@index([sellerId, createdAt])
  @@index([sellerId, sellerArchivedAt, createdAt])
  @@index([mode, status, createdAt])
  @@index([preorderStatus, preorderDeadline])
  @@map("listings")
}

enum Category {
  ELECTRONICS
  BOOKS
  FASHION
  FOOD
  SERVICES
  SPORTS
  OTHER
}

enum ListingType {
  PRODUCT
  SERVICE
}

enum ListingMode {
  ONE_OFF
  STOCKED
  PREORDER
  SERVICE
}

enum PreorderStatus {
  OPEN
  CLOSED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

// Komentar inline pada nilai enum tidak didukung Prisma,
// jadi ditulis di atas sebagai block comment.
// PENDING  = Status lama sebelum post-moderation (dipertahankan untuk kompatibilitas)
// ACTIVE   = Langsung tampil di marketplace
// REJECTED = Status lama untuk listing yang pernah ditolak
// SOLD     = Terjual (khusus PRODUCT)
// INACTIVE = Dinonaktifkan oleh pemilik
// HIDDEN   = Disembunyikan admin selama/hasil pemeriksaan laporan
// REMOVED  = Dihapus admin karena melanggar aturan komunitas
enum ListingStatus {
  PENDING
  ACTIVE
  REJECTED
  SOLD
  INACTIVE
  HIDDEN
  REMOVED
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

// ─────────────────────────────────────────────
// TRANSACTION
// ─────────────────────────────────────────────
// PENDING   = Menunggu pembayaran dari buyer
// PAID      = Buyer sudah bayar, masuk escrow, menunggu konfirmasi seller
// CONFIRMED = Seller konfirmasi proses (dipakai untuk kurir; meetup langsung melewati tahap ini)
// COMPLETED = Selesai, dana dilepas ke seller
// CANCELLED = Dibatalkan, dana dikembalikan ke buyer
model Transaction {
  id             String            @id @default(uuid())
  listingId      String
  listing        Listing           @relation(fields: [listingId], references: [id])
  buyerId        String
  buyer          User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  sellerId       String
  seller         User              @relation("SellerTransactions", fields: [sellerId], references: [id])
  status         TransactionStatus @default(PENDING)
  note           String?
  quantity       Int               @default(1) // Jumlah yang dibeli buyer
  price          Decimal           @db.Decimal(12, 2) // Harga satuan
  totalPrice     Decimal           @db.Decimal(12, 2) // Harga total (price x quantity)
  fulfillmentMethod FulfillmentMethod @default(CAMPUS_MEETUP)
  meetupCampus      String?
  meetupLocation    String?
  meetupSchedule    String?
  courierProvider   CourierProvider?
  deliveryAddress   String?
  recipientPhone    String?
  shippingFee       Decimal           @default(0.00) @db.Decimal(12, 2)
  grandTotal        Decimal           @default(0.00) @db.Decimal(12, 2)
  trackingNumber    String?
  handoverCodeHash      String?
  handoverCodeExpiresAt DateTime?
  handoverVerifiedAt    DateTime?
  commissionRate Decimal           @default(5.00) @db.Decimal(5, 2)
  commissionAmt  Decimal           @default(0.00) @db.Decimal(12, 2)
  sellerReceives Decimal           @default(0.00) @db.Decimal(12, 2)
  isEscrowHeld   Boolean           @default(false)
  paidAt          DateTime?
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancellationReason String?
  // V21: stok checkout hanya direservasi sementara sampai timestamp ini.
  reservationExpiresAt DateTime?
  // V21: snapshot immutable agar histori transaksi tidak berubah ketika listing diedit.
  listingTitleSnapshot     String?
  listingImageSnapshot     String?
  listingTypeSnapshot      ListingType?
  listingModeSnapshot      ListingMode?
  listingConditionSnapshot Condition?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  review  Review?
  dispute      Dispute?
  walletLedger WalletLedger[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
  @@index([fulfillmentMethod, status])
  @@index([listingId])
  @@map("transactions")
}

enum TransactionStatus {
  PENDING // Menunggu pembayaran buyer
  PAID // Buyer sudah bayar, dana di escrow
  CONFIRMED // Seller konfirmasi
  COMPLETED // Selesai, dana dilepas ke seller
  CANCELLED // Dibatalkan
}

enum FulfillmentMethod {
  CAMPUS_MEETUP
  INSTANT_COURIER
}

enum CourierProvider {
  GOSEND
  GRABEXPRESS
}

// ─────────────────────────────────────────────
// COMMISSION SETTING (Admin bisa ubah %)
// ─────────────────────────────────────────────
model CommissionSetting {
  id        String   @id @default(uuid())
  rate      Decimal  @db.Decimal(5, 2) // contoh: 5.00 = 5%
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commission_settings")
}

// ─────────────────────────────────────────────
// SAVED & DISCOVERY (V23)
// ─────────────────────────────────────────────
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
  @@map("wishlists")
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId, viewedAt])
  @@index([listingId])
  @@map("recently_viewed")
}

// ─────────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────────
model Review {
  id            String      @id @default(uuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  reviewerId    String
  reviewer      User        @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId    String
  reviewee      User        @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([revieweeId, createdAt])
  @@map("reviews")
}

// ─────────────────────────────────────────────
// DISPUTE & SAFETY (V24)
// ─────────────────────────────────────────────
model Dispute {
  id            String            @id @default(uuid())
  transactionId String            @unique
  transaction   Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  openedById    String
  openedBy      User              @relation("DisputesOpened", fields: [openedById], references: [id])
  reason        DisputeReason
  description   String            @db.Text
  evidenceUrls  String            @default("[]") @db.Text
  status        DisputeStatus     @default(OPEN)
  resolution    DisputeResolution?
  resolutionNote String?          @db.Text
  refundAmount  Decimal?          @db.Decimal(12, 2)
  resolvedById  String?
  resolvedBy    User?             @relation("DisputesResolved", fields: [resolvedById], references: [id])
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([openedById, createdAt])
  @@map("disputes")
}

enum DisputeReason {
  ITEM_NOT_AS_DESCRIBED
  ITEM_DAMAGED
  NOT_RECEIVED
  SELLER_NO_SHOW
  BUYER_NO_SHOW
  OTHER
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum DisputeResolution {
  REFUND_BUYER
  RELEASE_SELLER
  REJECT_DISPUTE
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId, createdAt])
  @@index([blockedId])
  @@map("user_blocks")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS & WALLET AUDIT (V25)
// ─────────────────────────────────────────────
model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String           @db.Text
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

enum NotificationType {
  TRANSACTION
  CHAT
  REVIEW
  DISPUTE
  SYSTEM
}

model WalletLedger {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId  String?
  transaction    Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  type           LedgerType
  balanceDelta   Decimal     @default(0.00) @db.Decimal(12, 2)
  escrowDelta    Decimal     @default(0.00) @db.Decimal(12, 2)
  balanceAfter   Decimal     @db.Decimal(12, 2)
  escrowAfter    Decimal     @db.Decimal(12, 2)
  description    String?     @db.Text
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([transactionId])
  @@map("wallet_ledger")
}

enum LedgerType {
  TOPUP
  PURCHASE_HOLD
  REFUND
  ESCROW_RELEASE
  SELLER_PAYOUT
}

// ─────────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────────
// FIX: @@unique([userAId, userBId]) saja TIDAK CUKUP karena
// jika A=1,B=2 sudah ada, maka A=2,B=1 masih bisa dibuat
// dan akan jadi duplikat room untuk pasangan yang sama.
// Solusinya: enforce urutan di aplikasi (userAId < userBId)
// sehingga pasangan apapun selalu disimpan dengan ID terkecil di userA.
// Logika ini diterapkan di chat.controller.js saat getOrCreateChatRoom.
model ChatRoom {
  id        String   @id @default(uuid())
  userAId   String
  userA     User     @relation("UserA", fields: [userAId], references: [id])
  userBId   String
  userB     User     @relation("UserB", fields: [userBId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, updatedAt])
  @@index([userBId, updatedAt])
  @@map("chat_rooms")
}

model Message {
  id         String   @id @default(uuid())
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id])
  senderId   String
  sender     User     @relation("MessagesSent", fields: [senderId], references: [id])
  content    String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([chatRoomId, createdAt])
  @@index([chatRoomId, isRead, senderId])
  @@map("messages")
}

// ─────────────────────────────────────────────
// COMPLAINT
// ─────────────────────────────────────────────
// OPEN      = Baru dibuat, belum ditangani
// IN_REVIEW = Sedang ditinjau admin
// RESOLVED  = Selesai ditangani
// DISMISSED = Ditolak / tidak valid
model Complaint {
  id          String          @id @default(uuid())
  reporterId  String
  reporter    User            @relation(fields: [reporterId], references: [id])
  targetType  ComplaintTarget
  targetId    String
  reason      String          @db.Text
  description String?         @db.Text
  status      ComplaintStatus @default(OPEN)
  adminNote   String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetType, targetId])
  @@map("complaints")
}

enum ComplaintTarget {
  USER
  LISTING
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}
